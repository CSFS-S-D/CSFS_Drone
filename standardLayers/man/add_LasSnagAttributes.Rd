\name{add_LasSnagAttributes}
\alias{add_LasSnagAttributes}
%- Also NEED an '\alias' for EACH other topic documented here.
\title{
  Add LAS snag attributes.
}
\description{
%%  ~~ A concise (1-5 lines) description of what the function does. ~~
  Takes the outputs from cloud2trees and snagMapper to calculate and add tree height, 
  tree dbh, and percentage of snag points per tree attributes to the point cloud. 
  It is intended to help filter a point cloud to get a snag count.
}
\usage{
add_LasSnagAttributes(pc, ttops)
}
%- maybe also 'usage' for other objects documented here.
\arguments{
  \item{pc}{
  %%     ~~Describe \code{x} here~~
  An LAS point cloud that has a treeID attribute generated by cloud2trees and 
  standardLayers.
  }
  \item(ttops){
  A simple feature collection of treetop locations, heights, and treeIDs that correspond 
  to the LAS point cloud supplied for "pc."
  }
}
